#!/usr/bin/env bash
# Clipboard history picker for cliphist (services.cliphist stores each copy).
# When you select an entry, the script copies the entry to the clipboard again.
# ^d deletes the selected entry. ^w deletes the full history. Like lm10-sesh,
# the script makes its own list (lm10-clip --list), so the reload binds can also
# run the script.
set -euo pipefail

# Prints the entries as lines that lm10 reads back. The name is in single
# quotes, without control characters, because a preview can contain tabs or
# escape sequences. The ID is a number. The ID is the last argv word, {4}.
list() {
  cliphist list | while IFS=$'\t' read -r id preview; do
    preview=$(tr -d '[:cntrl:]' <<<"$preview")
    printf -- "-X -n '%s' -- sh -c 'cliphist decode \"\$1\" | wl-copy' sh %s\n" \
      "${preview//\'/\'\\\'\'}" "$id"
  done
}

if [[ ${1:-} == --list ]]; then
  list
  exit
fi

printf -v self %q "$(realpath "$0")"
list | "${LM10:-lm10}" \
  --width 50% \
  --prompt '📋  ' \
  --header '^d delete  ^w wipe' \
  --bind "Control+d=execute(echo {4} | cliphist delete)+reload($self --list)" \
  --bind "Control+w=execute(cliphist wipe)+reload($self --list)"
