{
  "logStart": {
    "prefix": "lstart",
    "body": [
      "START - ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}:${CURRENT_SECOND} - ${1:description}"
    ],
    "description": "Log start in timesheet"
  },
  "logEnd": {
    "prefix": "lend",
    "body": [
      "END - ${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}T${CURRENT_HOUR}:${CURRENT_MINUTE}:${CURRENT_SECOND} - ${1:description}"
    ],
    "description": "Log end in timesheet"
  }
}
