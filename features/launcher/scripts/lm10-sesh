#!/usr/bin/env bash
# The sesh picker, based on the sesh_all function of fish. The script connects
# to each selected session in kitty. The script makes its own lists
# (`lm10-sesh --list WHAT`), so the reload binds can also run the script. lm10
# has no preview and cannot read a new name. Thus, this script does not have the
# preview and the ^r rename of sesh_all.
set -euo pipefail

# Prints the entries as lines, quoted with %q. lm10 reads these lines back.
# The session is the last argv word. In
# `kitty --single-instance -- sesh connect SESSION`, the session is {5}.
entry() {
  printf -- '-X -n %q -- kitty --single-instance -- sesh connect %q\n' "$1" "$2"
}

list() {
  case ${1:-} in
  find)
    fd -H -d 2 -t d -E .Trash . ~ | while IFS= read -r dir; do
      entry "~${dir#"$HOME"}" "$dir"
    done
    ;;
  *)
    # The icons contain colour codes. lm10 shows the text without changes.
    sesh list --icons "$@" | sed 's/\x1b\[[0-9;]*m//g' |
      while IFS= read -r line; do
        entry "$line" "${line#* }"
      done
    ;;
  esac
}

if [[ ${1:-} == --list ]]; then
  shift
  list "$@"
  exit
fi

printf -v self %q "$(realpath "$0")"
list | lm10 \
  --width 40% \
  --prompt '⚡  ' \
  --header '^a  ^t  ^x  ^f  ^d' \
  --bind "Control+a=change-prompt(⚡  )+reload($self --list)" \
  --bind "Control+t=change-prompt(🪟  )+reload($self --list -t)" \
  --bind "Control+x=change-prompt(📁  )+reload($self --list -z)" \
  --bind "Control+f=change-prompt(🔎  )+reload($self --list find)" \
  --bind "Control+d=execute(tmux kill-session -t {5})+change-prompt(⚡  )+reload($self --list)"
